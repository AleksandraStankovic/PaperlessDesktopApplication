<UserControl x:Class="PaperlessDesktop.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Documents_Title}" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Documents_Subtitle}" Opacity="0.7" Margin="0,4,0,24" />

        <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Documents_Load}" Command="{Binding LoadCommand}" />
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Margin="16,0,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <TextBlock Margin="0,16,0,0" FontSize="16">
            <Run Text="{DynamicResource Documents_Total}" />
            <Run Text="{Binding DocumentCount, Mode=OneWay}" FontWeight="Bold" />
        </TextBlock>
    </StackPanel>
</UserControl>