<UserControl x:Class="PaperlessDesktop.Views.DocumentsView"
             SizeChanged="OnSizeChanged"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <!-- Esc anywhere on this page closes the preview panel -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Preview.CloseCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Dropdown item: name + number of documents, e.g. "računi (12)" -->
        <DataTemplate x:Key="NameWithCountTemplate">
            <TextBlock>
                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding DocumentCount, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
        </DataTemplate>

        <!-- Tag dropdown item: color dot + name + count -->
        <DataTemplate x:Key="TagOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding DocumentCount, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Chip label prefix ("Tag", "Korespondent", "Tip") - translated, changes with language -->
        <Style x:Key="FilterKindLabelStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Tag">
                    <Setter Property="Text" Value="{DynamicResource Filter_Tag}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Correspondent">
                    <Setter Property="Text" Value="{DynamicResource Filter_Correspondent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DocumentType">
                    <Setter Property="Text" Value="{DynamicResource Filter_DocumentType}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Month">
                    <Setter Property="Text" Value="{DynamicResource Filter_Month}" />
                </DataTrigger>
            </Style.Triggers>
            
        </Style>

        <!-- Reused by table, cards AND preview, so tags look the same everywhere (consistency, H4) -->
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>


        <!-- Label/value text styles for the preview panel -->
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,3,16,3" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- One card in card view -->
        <DataTemplate x:Key="DocumentCardTemplate">
            <materialDesign:Card Width="210" Margin="4">
                <StackPanel>
                    <!-- Thumbnail area -->
                    <Grid Height="230" Background="#18808080">
                        <!-- Placeholder, shown until the thumbnail arrives -->
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="64" Height="64" Opacity="0.3"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                        <!-- HCI: thumbnail centered (web version is not) -->
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <StackPanel Margin="12,10,12,12">
                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                   FontWeight="SemiBold" FontSize="14"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />

                        <!-- HCI: dates have text labels, not just identical icons (problem 4 candidate) -->
                        <TextBlock FontSize="12" Opacity="0.75" Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{DynamicResource Col_Created}" /><Run Text=": " /><Run Text="{Binding Created, StringFormat=dd.MM.yyyy, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis">
                            <Run Text="{DynamicResource Col_Added}" /><Run Text=": " /><Run Text="{Binding Added, StringFormat=dd.MM.yyyy, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis">
                            <Run Text="{DynamicResource Col_DocumentType}" /><Run Text=": " /><Run Text="{Binding DocumentTypeName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis">
                            <Run Text="{DynamicResource Col_Correspondent}" /><Run Text=": " /><Run Text="{Binding CorrespondentName, Mode=OneWay}" />
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0"
                                      ItemTemplate="{StaticResource TagChipTemplate}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 0: header -->
            <RowDefinition Height="Auto" />
            <!-- 1: search & filters -->
            <RowDefinition Height="*" />
            <!-- 2: list + preview -->
            <RowDefinition Height="Auto" />
            <!-- 3: pagination -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <!-- Responsive: in a narrow window the view toggle + refresh move under the title
             (see DocumentsView.xaml.cs, ApplyResponsiveLayout) -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Documents_Title}" FontSize="26" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{DynamicResource Documents_Subtitle}" Opacity="0.7" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="HeaderActions" Grid.Row="0" Grid.Column="1" Margin="16,0,0,0"
                        Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,12,0" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource Accent.Text}" BorderBrush="{DynamicResource Accent.Text}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Common_Refresh}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- HCI: view toggle shows icon AND text, and the active mode is highlighted
                     with a tint of the user's accent color (H1, H6, consistent with the sidebar - H4) -->
                <ListBox VerticalAlignment="Center"
                         Style="{StaticResource MaterialDesignToolToggleListBox}"
                         SelectedIndex="{Binding ViewModeIndex}">
                    <ListBox.Resources>
                        <!-- Hide MaterialDesign's grey "selected" overlay; the accent tint below replaces it -->
                        <SolidColorBrush x:Key="MaterialDesign.Brush.ListBoxItem.Selected" Color="Transparent" />
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignToolToggleListBoxItem}">
                            <Style.Triggers>
                                <!-- Soft accent tint (ThemeService); text keeps the normal page color.
                                     DynamicResource, so it follows a new accent from Settings right away. -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent.SelectedOverlay}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource View_Table}" Margin="6,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewGridOutline" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource View_Cards}" Margin="6,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- ===== Search & filters ===== -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">

            <!-- Responsive filter row. Wide window: search + 3 dropdowns on one line, sharing the
                 width proportionally. Narrow window: search on its own line, the 3 dropdowns
                 share the line below. Positions are switched in DocumentsView.xaml.cs. -->
            <Grid x:Name="FilterGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SearchColumn" Width="1.6*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search + keyboard tip. The tip is a normal TextBlock (not MaterialDesign HelperText),
                     so it lines up with the left edge of the box and takes up real space in the layout. -->
                <StackPanel x:Name="SearchPanel" Grid.Row="0" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Top">
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Search_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             materialDesign:TextFieldAssist.HasClearButton="True">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{DynamicResource Search_KeyboardTip}"
                               FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Filter pickers: choosing an item adds a chip below -->
                <ComboBox x:Name="TagFilter" Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" VerticalAlignment="Top"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{DynamicResource Filter_AddTag}"
                          ToolTip="{DynamicResource Filter_TagTooltip}"
                          ItemsSource="{Binding Filters.AvailableTags}"
                          SelectedItem="{Binding Filters.TagToAdd}"
                          ItemTemplate="{StaticResource TagOptionTemplate}" />

                <ComboBox x:Name="CorrespondentFilter" Grid.Row="0" Grid.Column="2" Margin="0,0,12,8" VerticalAlignment="Top"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{DynamicResource Filter_AddCorrespondent}"
                          ItemsSource="{Binding Filters.AvailableCorrespondents}"
                          SelectedItem="{Binding Filters.CorrespondentToSet}"
                          ItemTemplate="{StaticResource NameWithCountTemplate}" />

                <ComboBox x:Name="DocumentTypeFilter" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" VerticalAlignment="Top"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{DynamicResource Filter_AddDocumentType}"
                          ItemsSource="{Binding Filters.AvailableDocumentTypes}"
                          SelectedItem="{Binding Filters.DocumentTypeToSet}"
                          ItemTemplate="{StaticResource NameWithCountTemplate}" />
            </Grid>

            <!-- HCI problem 1: active filters always visible, each removable with ONE click (H1, H3) -->
            <WrapPanel Margin="0,4,0,0"
                       Visibility="{Binding Filters.HasActiveFilters, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource Filter_Active}" VerticalAlignment="Center"
                           Opacity="0.7" Margin="0,0,8,0" />

                <ItemsControl ItemsSource="{Binding Filters.ActiveFilters}"
                              ItemsPanel="{StaticResource WrapPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Chip Margin="0,4,8,4" IsDeletable="True"
                                                 DeleteCommand="{Binding DataContext.Filters.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 DeleteCommandParameter="{Binding}">
                                <!-- Tag filters are shown in the tag's own color (consistent with the list, H4) -->
                                <materialDesign:Chip.Style>
                                    <Style TargetType="materialDesign:Chip">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Tag">
                                                <Setter Property="Background" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                <Setter Property="Foreground" Value="{Binding TextColor, Converter={StaticResource HexToBrush}, ConverterParameter=#000000}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:Chip.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FilterKindLabelStyle}" Opacity="0.7" />
                                    <TextBlock Text=": " Opacity="0.7" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </StackPanel>
                            </materialDesign:Chip>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- "Clear all" sits right next to the chips, so it's clear what it will remove -->
                <Button Content="{DynamicResource Filter_ClearAll}"
                        Command="{Binding Filters.ClearAllCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource Accent.Text}"
                        VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>

        <!-- List | splitter | preview. Column widths are managed in code-behind
             (DocumentsView.xaml.cs, UpdateContentColumns): list and preview share the space
             equally by default, the splitter lets the user resize them, and in a narrow
             window the preview covers the list instead of squeezing both. -->
        <Grid x:Name="ContentGrid" Grid.Row="2" Margin="0,8,0,0" SizeChanged="OnContentSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">

               
                <DataGrid ItemsSource="{Binding Documents}"
                          SelectedItem="{Binding SelectedDocument}"
                          Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Title}" Width="2*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Col_Title}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- HCI: one date format everywhere + clearly labeled dates (problem 4 candidate) -->
                        <DataGridTextColumn Binding="{Binding Created, StringFormat=dd.MM.yyyy}" Width="Auto">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Col_Created}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Added, StringFormat=dd.MM.yyyy}" Width="Auto">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Col_Added}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding CorrespondentName}" Width="Auto">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Col_Correspondent}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding DocumentTypeName}" Width="Auto">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Col_DocumentType}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="*" MinWidth="120">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Col_Tags}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Tags}"
                                                  ItemTemplate="{StaticResource TagChipTemplate}"
                                                  ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Card view -->
                <ListBox ItemsSource="{Binding Documents}"
                         SelectedItem="{Binding SelectedDocument}"
                         ItemTemplate="{StaticResource DocumentCardTemplate}"
                         Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- Empty state: no documents at all -->
                <TextBlock Text="{DynamicResource Documents_Empty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Opacity="0.6"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />

                <!-- HCI: search/filters found nothing - say so clearly and offer a way out (H9, H3) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="FileSearchOutline" Width="56" Height="56"
                                             HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="{DynamicResource Filter_NoResults}" FontSize="16"
                               Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button Content="{DynamicResource Filter_ResetAll}" Command="{Binding ResetAllCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource Accent.Text}" BorderBrush="{DynamicResource Accent.Text}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Loading indicator -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="48" Height="48"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>

       
            <!-- Drag to resize list vs. preview (transparent; the 16px gap between them is the grab area) -->
            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="16"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Background="Transparent" Focusable="False"
                          Visibility="Collapsed" DragCompleted="OnSplitterDragCompleted" />

            <materialDesign:Card x:Name="PreviewCard" Grid.Column="2"
                                 DataContext="{Binding Preview}"
                                 Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                 IsVisibleChanged="OnPreviewVisibilityChanged"
                                 SizeChanged="OnPreviewCardSizeChanged">
                <DockPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="16,12,8,4">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="{DynamicResource Preview_Close}">
                            <materialDesign:PackIcon Kind="Close" />
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenExternallyCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="{DynamicResource Preview_OpenExternal}">
                            <materialDesign:PackIcon Kind="OpenInNew" />
                        </Button>
                        <TextBlock Text="{Binding Document.Title}" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Key metadata. Capped to part of the card height (code-behind) and scrolls,
                         so the file preview below always keeps most of the space. -->
                    <ScrollViewer x:Name="PreviewMetaScroll" DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,0,16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Col_Created}" Style="{StaticResource MetaLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Document.Created, StringFormat=dd.MM.yyyy}" Style="{StaticResource MetaValue}" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Col_Added}" Style="{StaticResource MetaLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Document.Added, StringFormat=dd.MM.yyyy}" Style="{StaticResource MetaValue}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Col_Correspondent}" Style="{StaticResource MetaLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Document.CorrespondentName}" Style="{StaticResource MetaValue}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Col_DocumentType}" Style="{StaticResource MetaLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Document.DocumentTypeName}" Style="{StaticResource MetaValue}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Document.Tags}" Margin="0,8,0,0"
                                      ItemTemplate="{StaticResource TagChipTemplate}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}" />

                        <!-- Technical details: available, but out of the way -->
                        <Expander Header="{DynamicResource Preview_MoreDetails}" Margin="-8,8,-8,0">
                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Preview_Modified}" Style="{StaticResource MetaLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Document.Modified, StringFormat=dd.MM.yyyy HH:mm}" Style="{StaticResource MetaValue}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Preview_OriginalFile}" Style="{StaticResource MetaLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Document.OriginalFileName, TargetNullValue=—}" Style="{StaticResource MetaValue}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Preview_Pages}" Style="{StaticResource MetaLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Document.PageCount, TargetNullValue=—}" Style="{StaticResource MetaValue}" />

                                <!-- HCI: "ASN" explained in plain words (H2) -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Preview_Asn}" Style="{StaticResource MetaLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Document.ArchiveSerialNumber, TargetNullValue=—}" Style="{StaticResource MetaValue}" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- File preview fills the remaining space -->
                    <Grid Margin="8,0,8,8">
                        <wv2:WebView2 Source="{Binding PreviewUri, FallbackValue=about:blank, TargetNullValue=about:blank}"
                                      Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVis}}" />

                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="40" Height="40"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVis}}" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding PreviewFailed, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="FileAlertOutline" Width="48" Height="48"
                                                     HorizontalAlignment="Center" Opacity="0.4" />
                            <TextBlock Text="{DynamicResource Preview_Failed}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <!-- ===== Pagination ===== -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.7">
                <Run Text="{DynamicResource Documents_Total}" />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
            </TextBlock>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Pagination_PageSize}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"
                          Width="70" Margin="0,0,24,0" VerticalAlignment="Center" />

                <!-- HCI: icon buttons always have tooltips -->
                <Button Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="{DynamicResource Pagination_Previous}">
                    <materialDesign:PackIcon Kind="ChevronLeft" />
                </Button>

                <TextBlock VerticalAlignment="Center" Margin="8,0">
                    <Run Text="{DynamicResource Pagination_Page}" />
                    <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{DynamicResource Pagination_Of}" />
                    <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>

                <Button Command="{Binding NextPageCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="{DynamicResource Pagination_Next}">
                    <materialDesign:PackIcon Kind="ChevronRight" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>