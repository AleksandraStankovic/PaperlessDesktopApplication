<UserControl x:Class="PaperlessDesktop.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource Accent.Text}" BorderBrush="{DynamicResource Accent.Text}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common_Refresh}" Margin="8,0,0,0" />
                </StackPanel>
            </Button>

            <!-- Primary action: prominent (your HCI note: the web's main action button was not) -->
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                    Command="{Binding CreateTagCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Tags_New}" Margin="8,0,0,0" />
                </StackPanel>
            </Button>

            <StackPanel>
                <TextBlock Text="{DynamicResource Tags_Title}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Tags_Subtitle}" Opacity="0.7" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- ===== List ===== -->
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Tags}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource Tags_Col_Tag}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TagChipTemplate}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding DocumentCount}" Width="Auto">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Tags_Col_Documents}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- Actions: icon buttons with tooltips -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="{DynamicResource Common_Edit}"
                                            Command="{Binding DataContext.EditTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="PencilOutline" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="{DynamicResource Common_Delete}" Foreground="#D32F2F"
                                            Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="DeleteOutline" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{DynamicResource Tags_Empty}" FontSize="16" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />

            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>