<UserControl x:Class="PaperlessDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Settings_Title}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Settings_Subtitle}" Opacity="0.7" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="0,0,16,16">

                <materialDesign:Card Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Language}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ListBox Style="{StaticResource MaterialDesignToolToggleListBox}"
                                 SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Left">
                            <ListBox.Resources>
                                <SolidColorBrush x:Key="MaterialDesign.Brush.ListBoxItem.Selected" Color="Transparent" />
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignToolToggleListBoxItem}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Accent.SelectedOverlay}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem Content="Srpski" />
                            <ListBoxItem Content="English" />
                        </ListBox>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Theme}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ListBox Style="{StaticResource MaterialDesignToolToggleListBox}"
                                 SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Left">
                            <ListBox.Resources>
                                <SolidColorBrush x:Key="MaterialDesign.Brush.ListBoxItem.Selected" Color="Transparent" />
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignToolToggleListBoxItem}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Accent.SelectedOverlay}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="WeatherSunny" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Settings_ThemeLight}" Margin="6,0,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="WeatherNight" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Settings_ThemeDark}" Margin="6,0,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Color}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Settings_ColorHint}" Opacity="0.65" FontSize="12" Margin="0,2,0,12" />

                        <ItemsControl ItemsSource="{Binding PresetColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding}"
                                            Command="{Binding DataContext.SetPresetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="32" Height="32" CornerRadius="16"
                                                        BorderBrush="#40808080" BorderThickness="1"
                                                        Background="{Binding Converter={StaticResource HexToGradient}}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <materialDesign:ColorPicker Color="{Binding PrimaryColor, Mode=TwoWay}" Height="160" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource Settings_Preview}" VerticalAlignment="Center"
                                       Opacity="0.7" Margin="0,0,12,0" />
                            <Button Content="{DynamicResource Settings_SampleButton}" IsHitTestVisible="False" />
                            <CheckBox IsChecked="True" IsHitTestVisible="False" Margin="16,0,0,0"
                                      Content="{DynamicResource Settings_SampleCheckbox}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrimaryColorHex}" VerticalAlignment="Center"
                                       Opacity="0.5" FontSize="12" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Left" Command="{Binding ResetToDefaultsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource Accent.Text}" BorderBrush="{DynamicResource Accent.Text}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Settings_Reset}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding HasSavedText, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="{DynamicResource Status.Success.Text}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SavedText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Status.Success.Text}" />
                    </StackPanel>
                </DockPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>