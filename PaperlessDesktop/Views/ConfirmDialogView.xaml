<UserControl x:Class="PaperlessDesktop.Views.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <StackPanel Margin="24" MaxWidth="440"
                FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,24" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding ConfirmText}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <sys:Boolean>True</sys:Boolean>
                </Button.CommandParameter>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="Background" Value="#D32F2F" />
                                <Setter Property="BorderBrush" Value="#D32F2F" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="CancelButton" IsCancel="True"
                    Content="{DynamicResource Common_Cancel}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="8,0,0,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <sys:Boolean>False</sys:Boolean>
                </Button.CommandParameter>
            </Button>

        </StackPanel>
    </StackPanel>
</UserControl>