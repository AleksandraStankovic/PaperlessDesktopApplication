<UserControl x:Class="PaperlessDesktop.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             SizeChanged="OnSizeChanged">

    <UserControl.Resources>
        <sys:Double x:Key="AnalyticsMaxWidth">1200</sys:Double>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A clickable chart element: no button look, just a soft highlight on hover -->
        <Style x:Key="ChartItemButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A808080" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One donut slice. A named style on purpose: MaterialDesign's implicit Button style
             gives every button Height=32, which pushed the slices down under the total in the middle. -->
        <Style x:Key="PieSliceButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Path x:Name="Slice" Data="{Binding Geometry}"
                              Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                              Stroke="White" StrokeThickness="1.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Slice" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The page is a centered column (MaxWidth); inside it every section stretches to the full width -->
    <DockPanel>
        <!-- ===== Header ===== -->
        <DockPanel DockPanel.Dock="Top" MaxWidth="{StaticResource AnalyticsMaxWidth}" Margin="16,0,16,16">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource Accent.Text}" BorderBrush="{DynamicResource Accent.Text}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Common_Refresh}" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{DynamicResource Analytics_Title}" FontSize="26" FontWeight="SemiBold" />
                <!-- HCI: tell the user that charts are clickable (H10) -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.7">
                    <materialDesign:PackIcon Kind="GestureTap" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource Analytics_ClickHint}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="{StaticResource AnalyticsMaxWidth}" Margin="16,0,16,16">

                    <!-- ===== Summary tiles ===== -->
                    <!-- Each tile has 6px on both sides; the -6 margin lines the outer edges up with the cards below -->
                    <UniformGrid Columns="4" Margin="-6,0,-6,16">
                        <materialDesign:Card Margin="6,0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalDocuments}" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{DynamicResource Analytics_TotalDocuments}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="6,0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding TagCount}" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{DynamicResource Analytics_Tags}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="6,0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding CorrespondentCount}" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{DynamicResource Analytics_Correspondents}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="6,0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding DocumentTypeCount}" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{DynamicResource Analytics_DocumentTypes}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <!-- Pie chart + tag cloud: side by side, each half of the width and the same height.
                         In a narrow window they go one under the other (AnalyticsView.xaml.cs). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ===== Pie chart: documents by type ===== -->
                        <materialDesign:Card x:Name="TypeCard" Grid.Row="0" Grid.Column="0"
                                             Margin="0,0,8,16" Padding="20,16">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Analytics_ByType}" Style="{StaticResource SectionTitle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Donut: all slices drawn on top of each other in one Grid -->
                                    <Grid Width="{Binding PieSize}" Height="{Binding PieSize}">
                                        <ItemsControl ItemsSource="{Binding TypeSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource PieSliceButton}"
                                                            ToolTip="{Binding Tooltip}" IsEnabled="{Binding IsClickable}"
                                                            Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Total in the middle of the donut -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding TotalDocuments}" FontSize="26" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Analytics_DocumentsShort}" Opacity="0.6"
                                                       HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Legend (also clickable - bigger targets than thin slices) -->
                                    <ItemsControl ItemsSource="{Binding TypeSlices}" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ChartItemButton}" Padding="6,3"
                                                        ToolTip="{Binding Tooltip}" IsEnabled="{Binding IsClickable}"
                                                        Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                 Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                        <TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding PercentText}" Opacity="0.6" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </materialDesign:Card>

                        <!-- ===== Tag cloud ===== -->
                        <materialDesign:Card x:Name="TagCloudCard" Grid.Row="0" Grid.Column="1"
                                             Margin="8,0,0,16" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Analytics_TagCloud}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Analytics_TagCloudHint}" Opacity="0.6" FontSize="12" Margin="0,2,0,12" />

                                <ItemsControl ItemsSource="{Binding TagCloud}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChartItemButton}" Padding="2" Margin="2"
                                                    ToolTip="{Binding Tooltip}"
                                                    Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Border CornerRadius="12" Padding="10,2"
                                                        Background="{Binding Tag.Color, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Tag.Name}" FontSize="{Binding FontSize}"
                                                               Foreground="{Binding Tag.TextColor, Converter={StaticResource HexToBrush}, ConverterParameter=#000000}" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>

                    <!-- ===== Bar chart: documents by month ===== -->
                    <materialDesign:Card Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Analytics_ByMonth}" Style="{StaticResource SectionTitle}" />

                            <!-- Year and month range are selectable -->
                            <WrapPanel Margin="0,12,0,0">
                                <ComboBox Width="110" Margin="0,0,12,8"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="{DynamicResource Analytics_Year}"
                                          ItemsSource="{Binding AvailableYears}"
                                          SelectedItem="{Binding SelectedYear}" />
                                <ComboBox Width="150" Margin="0,0,12,8"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="{DynamicResource Analytics_FromMonth}"
                                          ItemsSource="{Binding MonthNames}"
                                          SelectedIndex="{Binding FromMonthIndex}" />
                                <ComboBox Width="150" Margin="0,0,12,8"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="{DynamicResource Analytics_ToMonth}"
                                          ItemsSource="{Binding MonthNames}"
                                          SelectedIndex="{Binding ToMonthIndex}" />

                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                                             Width="20" Height="20" Margin="4,0,12,8" VerticalAlignment="Center"
                                             Visibility="{Binding IsLoadingMonths, Converter={StaticResource BoolToVis}}" />

                                <TextBlock VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Run Text="{DynamicResource Analytics_InSelectedPeriod}" />
                                    <Run Text="{Binding PeriodTotal, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </WrapPanel>

                            <!-- Bars: one column per month in the range -->
                            <ItemsControl ItemsSource="{Binding MonthBars}" Height="230" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChartItemButton}" Padding="2"
                                                ToolTip="{Binding Tooltip}" IsEnabled="{Binding HasDocuments}"
                                                Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="12" Opacity="0.7"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <StackPanel VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Count}" FontSize="12" HorizontalAlignment="Center"
                                                               Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVis}}" />
                                                    <Border Height="{Binding BarHeight}" CornerRadius="4,4,0,0" Margin="6,2,6,0"
                                                            Background="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Text="{DynamicResource Analytics_Empty}" FontSize="16" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />

            <!-- Loading -->
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                         Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</UserControl>