<Application x:Class="PaperlessDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:PaperlessDesktop.ViewModels"
             xmlns:views="clr-namespace:PaperlessDesktop.Views"
             xmlns:converters="clr-namespace:PaperlessDesktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Indigo"
                                             SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- Default language (so the designer shows text). Replaced at runtime by LocalizationService. -->
                <ResourceDictionary Source="Resources/Languages/Strings.sr.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sidebar look ("Sunset" gradient). Replaced at runtime by ThemeService from the accent color. -->
            <LinearGradientBrush x:Key="Sidebar.Background" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#6D28D9" Offset="0" />
                <GradientStop Color="#D92872" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Sidebar.SelectedBackground" Color="#40000000" />

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <converters:HexToGradientConverter x:Key="HexToGradient" />
            <converters:BoolToGridLengthConverter x:Key="PreviewColumnWidth" TrueLength="2*" />

            <!-- Shared templates (used on several pages, so tags look the same everywhere) -->
            <DataTemplate x:Key="TagChipTemplate">
                <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                        CornerRadius="10" Padding="8,2" Margin="0,2,4,2">
                    <TextBlock Text="{Binding Name}" FontSize="12"
                               Foreground="{Binding TextColor, Converter={StaticResource HexToBrush}, ConverterParameter=#000000}" />
                </Border>
            </DataTemplate>

            <!-- ViewModel → View mapping: pages -->
            <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
                <views:DocumentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UploadViewModel}">
                <views:UploadView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TagsViewModel}">
                <views:TagsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            

            <!-- ViewModel → View mapping: dialogs -->
            <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
                <views:ConfirmDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TagEditorViewModel}">
                <views:TagEditorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                <views:AnalyticsView />
            </DataTemplate>
            
            
        </ResourceDictionary>
    </Application.Resources>
</Application>