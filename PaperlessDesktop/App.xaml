<Application x:Class="PaperlessDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:PaperlessDesktop.ViewModels"
             xmlns:views="clr-namespace:PaperlessDesktop.Views"
             xmlns:converters="clr-namespace:PaperlessDesktop.Converters"
             xmlns:services="clr-namespace:PaperlessDesktop.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Indigo"
                                             SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <!-- Snackbar styles, so MainWindow can base the colored notifications on them -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Snackbar.xaml" />

                <!-- Default language (so the designer shows text). Replaced at runtime by LocalizationService. -->
                <ResourceDictionary Source="Resources/Languages/Strings.sr.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sidebar look ("Sunset" gradient). Replaced at runtime by ThemeService from the accent color. -->
            <LinearGradientBrush x:Key="Sidebar.Background" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#6D28D9" Offset="0" />
                <GradientStop Color="#D92872" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Sidebar.SelectedBackground" Color="#40000000" />

            <!-- Accent text + selected-toggle tint. Replaced at runtime by ThemeService (readable in light AND dark mode). -->
            <SolidColorBrush x:Key="Accent.Text" Color="#6D28D9" />
            <SolidColorBrush x:Key="Accent.SelectedOverlay" Color="#386D28D9" />

            <!-- Status colors (light theme values). Replaced at runtime by ThemeService for light/dark. -->
            <SolidColorBrush x:Key="Status.Success.Text" Color="#2E7D32" />
            <SolidColorBrush x:Key="Status.Error.Text" Color="#C62828" />
            <SolidColorBrush x:Key="Status.Warning.Text" Color="#B45309" />
            <SolidColorBrush x:Key="Status.Success.Background" Color="#E3F2E5" />
            <SolidColorBrush x:Key="Status.Success.Foreground" Color="#1B4D20" />
            <SolidColorBrush x:Key="Status.Error.Background" Color="#FBE6E5" />
            <SolidColorBrush x:Key="Status.Error.Foreground" Color="#7F1D1D" />

            <!-- Notification text: a check / alert icon next to success / error messages,
                 so the meaning doesn't depend on color alone (accessibility) -->
            <DataTemplate DataType="{x:Type services:NotificationMessage}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon x:Name="Icon" Width="20" Height="20" Margin="0,0,10,0"
                                             VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                        <Setter TargetName="Icon" Property="Kind" Value="CheckCircleOutline" />
                        <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsError}" Value="True">
                        <Setter TargetName="Icon" Property="Kind" Value="AlertCircleOutline" />
                        <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <converters:HexToGradientConverter x:Key="HexToGradient" />
            <converters:BoolToGridLengthConverter x:Key="PreviewColumnWidth" TrueLength="2*" />

            <!-- Shared templates (used on several pages, so tags look the same everywhere) -->
            <DataTemplate x:Key="TagChipTemplate">
                <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                        CornerRadius="10" Padding="8,2" Margin="0,2,4,2">
                    <TextBlock Text="{Binding Name}" FontSize="12"
                               Foreground="{Binding TextColor, Converter={StaticResource HexToBrush}, ConverterParameter=#000000}" />
                </Border>
            </DataTemplate>

            <!-- The ✕ on removable chips (tags, filters). MaterialDesign draws it on a fixed grey circle;
                 this one sits on a darker shade of the chip's own color (even darker on hover).
                 The Chip style below puts it on every chip when it loads (App.xaml.cs). -->
            <converters:DarkerBrushConverter x:Key="DarkerShade" Factor="0.75" />
            <converters:DarkerBrushConverter x:Key="DarkerShadeHover" Factor="0.6" />
            <ControlTemplate x:Key="ChipDeleteButtonTemplate" TargetType="Button">
                <Grid Background="Transparent" Cursor="Hand">
                    <Ellipse x:Name="Bg"
                             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=materialDesign:Chip}, Converter={StaticResource DarkerShade}}" />
                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=materialDesign:Chip}}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bg" Property="Fill"
                                Value="{Binding Background, RelativeSource={RelativeSource AncestorType=materialDesign:Chip}, Converter={StaticResource DarkerShadeHover}}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Every chip (default look) gets the ✕ above when it loads -->
            <Style TargetType="{x:Type materialDesign:Chip}" BasedOn="{StaticResource {x:Type materialDesign:Chip}}">
                <EventSetter Event="Loaded" Handler="Chip_Loaded" />
            </Style>

            <!-- ViewModel → View mapping: pages -->
            <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
                <views:DocumentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UploadViewModel}">
                <views:UploadView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TagsViewModel}">
                <views:TagsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            

            <!-- ViewModel → View mapping: dialogs -->
            <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
                <views:ConfirmDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TagEditorViewModel}">
                <views:TagEditorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                <views:AnalyticsView />
            </DataTemplate>
            
            
        </ResourceDictionary>
    </Application.Resources>
</Application>