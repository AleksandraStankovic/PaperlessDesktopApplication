<Window x:Class="PaperlessDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Paperless Desktop" Height="500" Width="700">

    <Grid Margin="24">
        <materialDesign:Card Padding="24" Width="460"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Paperless Desktop" FontSize="24" FontWeight="SemiBold" />

                <TextBlock Text="Test the connection to the Paperless-NGX server."
                           Margin="0,8,0,16" TextWrapping="Wrap" Opacity="0.7" />

                <Button x:Name="TestButton" Content="Test connection"
                        HorizontalAlignment="Left" Click="TestButton_Click" />

                <ProgressBar x:Name="Spinner"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Visibility="Collapsed"
                             HorizontalAlignment="Left" Margin="0,16,0,0" />

                <TextBlock x:Name="ResultText" Margin="0,16,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>