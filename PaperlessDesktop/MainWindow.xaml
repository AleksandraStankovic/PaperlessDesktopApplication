<Window x:Class="PaperlessDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource App_Title}"
        Height="700" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:ColorZone Grid.Column="0" Mode="PrimaryMid" VerticalAlignment="Stretch"
                                      Background="{DynamicResource Sidebar.Background}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource App_Title}"
                               FontSize="20" FontWeight="SemiBold" Margin="20,24,20,16" />

                    <ListBox SelectedIndex="{Binding SelectedPageIndex}"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="20,12" />
                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                <Setter Property="materialDesign:ListBoxItemAssist.SelectedFocusedBackground"
                                        Value="{DynamicResource Sidebar.SelectedBackground}" />
                                <Setter Property="materialDesign:ListBoxItemAssist.SelectedUnfocusedBackground"
                                        Value="{DynamicResource Sidebar.SelectedBackground}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        <Setter Property="Padding" Value="16,12,20,12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Documents}" Margin="16,0,0,0" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBoxOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Analytics}" Margin="16,0,0,0" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Upload" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Upload}" Margin="16,0,0,0" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TagMultipleOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Tags}" Margin="16,0,0,0" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Nav_Settings}" Margin="16,0,0,0" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </materialDesign:ColorZone>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32,24"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <materialDesign:Snackbar Grid.Column="1" MessageQueue="{Binding MessageQueue}">
                <materialDesign:Snackbar.Style>
                    <Style TargetType="materialDesign:Snackbar" BasedOn="{StaticResource {x:Type materialDesign:Snackbar}}">
                        <Setter Property="ActionButtonStyle">
                            <Setter.Value>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignSnackbarActionButton}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=materialDesign:Snackbar}}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="materialDesign:RippleAssist.Feedback"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border x:Name="HoverTint" CornerRadius="4" Opacity="0"
                                                            Background="{TemplateBinding Foreground}" />
                                                    <materialDesign:Ripple Padding="{TemplateBinding Padding}"
                                                                           HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                           VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                           Content="{TemplateBinding Content}"
                                                                           ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                           Focusable="False" ClipToBounds="True" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HoverTint" Property="Opacity" Value="0.12" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="HoverTint" Property="Opacity" Value="0.2" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.38" />
                                                    </Trigger>
                                                    <Trigger Property="DockPanel.Dock" Value="Bottom">
                                                        <Setter Property="Margin" Value="0,18,-8,-8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message.Content.IsSuccess, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Status.Success.Background}" />
                                <Setter Property="Foreground" Value="{DynamicResource Status.Success.Foreground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message.Content.IsError, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Status.Error.Background}" />
                                <Setter Property="Foreground" Value="{DynamicResource Status.Error.Foreground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Snackbar.Style>
            </materialDesign:Snackbar>
        </Grid>
    </materialDesign:DialogHost>
</Window>