<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    
    <sys:String x:Key="App_Title">Paperless Desktop</sys:String>
    <sys:String x:Key="Nav_Documents">Documents</sys:String>
    <sys:String x:Key="Nav_Upload">Upload</sys:String>
    <sys:String x:Key="Nav_Tags">Tags</sys:String>
    <sys:String x:Key="Nav_Settings">Settings</sys:String>
    <sys:String x:Key="Common_ComingSoon">Coming soon...</sys:String>

    
    <sys:String x:Key="Documents_Title">Documents</sys:String>
    <sys:String x:Key="Documents_Subtitle">All your documents in one place.</sys:String>
   
    <sys:String x:Key="Documents_Total">Total documents:</sys:String>

   
    <sys:String x:Key="Upload_Title">Upload document</sys:String>
    <sys:String x:Key="Tags_Title">Manage tags</sys:String>
    <sys:String x:Key="Settings_Title">Settings</sys:String>
    <sys:String x:Key="Settings_Language">Language</sys:String>

    
    <sys:String x:Key="Error_Unreachable">The server is unreachable. Check your internet connection.</sys:String>
    <sys:String x:Key="Error_Timeout">The server is not responding. Please try again.</sys:String>
    <sys:String x:Key="Error_Unauthorized">Access denied. The API token is invalid.</sys:String>
    <sys:String x:Key="Error_Forbidden">You don't have permission for this action.</sys:String>
    <sys:String x:Key="Error_NotFound">The requested item was not found.</sys:String>
    <sys:String x:Key="Error_BadRequest">The server rejected the request. Check the entered data.</sys:String>
    <sys:String x:Key="Error_ServerError">Server error. Please try again later.</sys:String>
    <sys:String x:Key="Error_InvalidResponse">The server returned unexpected data.</sys:String>
    <sys:String x:Key="Error_Unexpected">An unexpected error occurred.</sys:String>


    <!-- Common -->
    <sys:String x:Key="Common_Refresh">Refresh</sys:String>

    <!-- Document list -->
    <sys:String x:Key="Documents_Empty">No documents to show.</sys:String>
    <sys:String x:Key="Col_Title">Title</sys:String>
    <sys:String x:Key="Col_Created">Document date</sys:String>
    <sys:String x:Key="Col_Added">Added</sys:String>
    <sys:String x:Key="Col_Correspondent">Correspondent</sys:String>
    <sys:String x:Key="Col_DocumentType">Document type</sys:String>
    <sys:String x:Key="Col_Tags">Tags</sys:String>
    <sys:String x:Key="View_Table">Table</sys:String>
    <sys:String x:Key="View_Cards">Cards</sys:String>

    <!-- Search -->
    <sys:String x:Key="Search_Hint">Search by title or content...</sys:String>
    <sys:String x:Key="Search_KeyboardTip">Enter: search now · Esc: clear</sys:String>
    <sys:String x:Key="Search_NoResults">No results for</sys:String>
    <sys:String x:Key="Search_Clear">Clear search</sys:String>

    <!-- Filters -->
    <sys:String x:Key="Filter_AddTag">+ Tag</sys:String>
    <sys:String x:Key="Filter_AddCorrespondent">+ Correspondent</sys:String>
    <sys:String x:Key="Filter_AddDocumentType">+ Document type</sys:String>
    <sys:String x:Key="Filter_TagTooltip">Shows documents that have ALL selected tags</sys:String>
    <sys:String x:Key="Filter_Active">Active filters:</sys:String>
    <sys:String x:Key="Filter_ClearAll">Clear all filters</sys:String>
    <sys:String x:Key="Filter_Tag">Tag</sys:String>
    <sys:String x:Key="Filter_Correspondent">Correspondent</sys:String>
    <sys:String x:Key="Filter_DocumentType">Type</sys:String>
    <sys:String x:Key="Filter_NoResults">No documents match your search and filters.</sys:String>
    <sys:String x:Key="Filter_ResetAll">Reset search and filters</sys:String>

    <!-- Pagination -->
    <sys:String x:Key="Pagination_Page">Page</sys:String>
    <sys:String x:Key="Pagination_Of">of</sys:String>
    <sys:String x:Key="Pagination_PageSize">Per page:</sys:String>
    <sys:String x:Key="Pagination_Previous">Previous page</sys:String>
    <sys:String x:Key="Pagination_Next">Next page</sys:String>

    <!-- Preview panel -->
    <sys:String x:Key="Preview_Close">Close preview (Esc)</sys:String>
    <sys:String x:Key="Preview_OpenExternal">Open in default app</sys:String>
    <sys:String x:Key="Preview_MoreDetails">More details</sys:String>
    <sys:String x:Key="Preview_Modified">Last modified</sys:String>
    <sys:String x:Key="Preview_OriginalFile">Original file</sys:String>
    <sys:String x:Key="Preview_Pages">Pages</sys:String>
    <sys:String x:Key="Preview_Asn">Archive number (ASN)</sys:String>
    <sys:String x:Key="Preview_Failed">Preview is not available for this document.</sys:String>
    <sys:String x:Key="Preview_OpenFailed">The file can't be opened. No app is set up for this file type.</sys:String>

    <!-- Common actions -->
    <sys:String x:Key="Common_Cancel">Cancel</sys:String>
    <sys:String x:Key="Common_Save">Save</sys:String>
    <sys:String x:Key="Common_Edit">Edit</sys:String>
    <sys:String x:Key="Common_Delete">Delete</sys:String>

    <!-- Tags page -->
    <sys:String x:Key="Tags_Subtitle">Create, edit and delete tags.</sys:String>
    <sys:String x:Key="Tags_New">New tag</sys:String>
    <sys:String x:Key="Tags_Col_Tag">Tag</sys:String>
    <sys:String x:Key="Tags_Col_Documents">Documents</sys:String>
    <sys:String x:Key="Tags_Empty">No tags yet. Create the first one with "New tag".</sys:String>

    <!-- Tag editor -->
    <sys:String x:Key="Tags_NewTitle">New tag</sys:String>
    <sys:String x:Key="Tags_EditTitle">Edit tag</sys:String>
    <sys:String x:Key="Tags_Name">Tag name</sys:String>
    <sys:String x:Key="Tags_Color">Color</sys:String>
    <sys:String x:Key="Tags_Preview">Preview:</sys:String>
    <sys:String x:Key="Tags_Error_NameRequired">Name is required.</sys:String>
    <sys:String x:Key="Tags_Error_NameTooLong">Name can have at most 128 characters.</sys:String>
    <sys:String x:Key="Tags_Error_NameExists">A tag with this name already exists.</sys:String>
    <sys:String x:Key="Tags_Error_Rejected">The server did not accept the tag.</sys:String>

    <!-- Tag messages ({0} = tag name, {1} = number of documents) -->
    <sys:String x:Key="Tags_Created">Tag "{0}" was created.</sys:String>
    <sys:String x:Key="Tags_Updated">Tag "{0}" was saved.</sys:String>
    <sys:String x:Key="Tags_Deleted">Tag "{0}" was deleted.</sys:String>
    <sys:String x:Key="Tags_DeleteTitle">Delete tag?</sys:String>
    <sys:String x:Key="Tags_DeleteConfirm">Are you sure you want to delete the tag "{0}"? This can't be undone.</sys:String>
    <sys:String x:Key="Tags_DeleteConfirmUsed">The tag "{0}" is assigned to {1} documents. It will be removed from all of them; the documents themselves are kept. This can't be undone.</sys:String>

</ResourceDictionary>