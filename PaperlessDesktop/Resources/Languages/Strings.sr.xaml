<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- App & navigation -->
    <sys:String x:Key="App_Title">Paperless Desktop</sys:String>
    <sys:String x:Key="Nav_Documents">Dokumenti</sys:String>
    <sys:String x:Key="Nav_Upload">Dodaj dokument</sys:String>
    <sys:String x:Key="Nav_Tags">Tagovi</sys:String>
    <sys:String x:Key="Nav_Settings">Podešavanja</sys:String>
    <sys:String x:Key="Common_ComingSoon">Uskoro...</sys:String>

    <!-- Documents page -->
    <sys:String x:Key="Documents_Title">Dokumenti</sys:String>
    <sys:String x:Key="Documents_Subtitle">Svi vaši dokumenti na jednom mjestu.</sys:String>

    <sys:String x:Key="Documents_Total">Ukupno dokumenata:</sys:String>

    <!-- Other pages -->
    <sys:String x:Key="Upload_Title">Dodavanje dokumenta</sys:String>
    <sys:String x:Key="Tags_Title">Upravljanje tagovima</sys:String>
    <sys:String x:Key="Settings_Title">Podešavanja</sys:String>
    <sys:String x:Key="Settings_Language">Jezik</sys:String>

    <!-- Errors (key = "Error_" + ApiErrorKind) -->
    <sys:String x:Key="Error_Unreachable">Server je nedostupan. Provjerite internet konekciju.</sys:String>
    <sys:String x:Key="Error_Timeout">Server ne odgovara. Pokušajte ponovo.</sys:String>
    <sys:String x:Key="Error_Unauthorized">Pristup odbijen. API token nije ispravan.</sys:String>
    <sys:String x:Key="Error_Forbidden">Nemate dozvolu za ovu akciju.</sys:String>
    <sys:String x:Key="Error_NotFound">Traženi sadržaj nije pronađen.</sys:String>
    <sys:String x:Key="Error_BadRequest">Server je odbio zahtjev. Provjerite unesene podatke.</sys:String>
    <sys:String x:Key="Error_ServerError">Greška na serveru. Pokušajte kasnije.</sys:String>
    <sys:String x:Key="Error_InvalidResponse">Server je vratio neočekivane podatke.</sys:String>
    <sys:String x:Key="Error_Unexpected">Došlo je do neočekivane greške.</sys:String>


    <!-- Common -->
    <sys:String x:Key="Common_Refresh">Osvježi</sys:String>

    <!-- Document list -->
    <sys:String x:Key="Documents_Empty">Nema dokumenata za prikaz.</sys:String>
    <sys:String x:Key="Col_Title">Naziv</sys:String>
    <sys:String x:Key="Col_Created">Datum dokumenta</sys:String>
    <sys:String x:Key="Col_Added">Dodato</sys:String>
    <sys:String x:Key="Col_Correspondent">Korespondent</sys:String>
    <sys:String x:Key="Col_DocumentType">Tip dokumenta</sys:String>
    <sys:String x:Key="Col_Tags">Tagovi</sys:String>
    <sys:String x:Key="View_Table">Tabela</sys:String>
    <sys:String x:Key="View_Cards">Kartice</sys:String>


    <!-- Search -->
    <sys:String x:Key="Search_Hint">Pretraži po nazivu ili sadržaju...</sys:String>
    <sys:String x:Key="Search_KeyboardTip">Enter: traži odmah · Esc: obriši</sys:String>
    <sys:String x:Key="Search_NoResults">Nema rezultata za</sys:String>
    <sys:String x:Key="Search_Clear">Obriši pretragu</sys:String>

    <!-- Filters -->
    <sys:String x:Key="Filter_AddTag">+ Tag</sys:String>
    <sys:String x:Key="Filter_AddCorrespondent">+ Korespondent</sys:String>
    <sys:String x:Key="Filter_AddDocumentType">+ Tip dokumenta</sys:String>
    <sys:String x:Key="Filter_TagTooltip">Prikazuju se dokumenti koji imaju SVE izabrane tagove</sys:String>
    <sys:String x:Key="Filter_Active">Aktivni filteri:</sys:String>
    <sys:String x:Key="Filter_ClearAll">Poništi sve filtere</sys:String>
    <sys:String x:Key="Filter_Tag">Tag</sys:String>
    <sys:String x:Key="Filter_Correspondent">Korespondent</sys:String>
    <sys:String x:Key="Filter_DocumentType">Tip</sys:String>
    <sys:String x:Key="Filter_NoResults">Nema dokumenata koji odgovaraju pretrazi i filterima.</sys:String>
    <sys:String x:Key="Filter_ResetAll">Poništi pretragu i filtere</sys:String>
    

    <!-- Pagination -->
    <sys:String x:Key="Pagination_Page">Strana</sys:String>
    <sys:String x:Key="Pagination_Of">od</sys:String>
    <sys:String x:Key="Pagination_PageSize">Po strani:</sys:String>
    <sys:String x:Key="Pagination_Previous">Prethodna strana</sys:String>
    <sys:String x:Key="Pagination_Next">Sljedeća strana</sys:String>

    <!-- Preview panel -->
    <sys:String x:Key="Preview_Close">Zatvori pregled (Esc)</sys:String>
    <sys:String x:Key="Preview_OpenExternal">Otvori u podrazumijevanoj aplikaciji</sys:String>
    <sys:String x:Key="Preview_MoreDetails">Više detalja</sys:String>
    <sys:String x:Key="Preview_Modified">Posljednja izmjena</sys:String>
    <sys:String x:Key="Preview_OriginalFile">Originalni fajl</sys:String>
    <sys:String x:Key="Preview_Pages">Broj strana</sys:String>
    <sys:String x:Key="Preview_Asn">Arhivski broj (ASN)</sys:String>
    <sys:String x:Key="Preview_Failed">Pregled nije dostupan za ovaj dokument.</sys:String>
    <sys:String x:Key="Preview_OpenFailed">Fajl nije moguće otvoriti. Nijedna aplikacija nije podešena za ovaj tip fajla.</sys:String>

    <!-- Common actions -->
    <sys:String x:Key="Common_Cancel">Odustani</sys:String>
    <sys:String x:Key="Common_Save">Sačuvaj</sys:String>
    <sys:String x:Key="Common_Edit">Uredi</sys:String>
    <sys:String x:Key="Common_Delete">Obriši</sys:String>

    <!-- Tags page -->
    <sys:String x:Key="Tags_Subtitle">Kreirajte, uredite i obrišite tagove.</sys:String>
    <sys:String x:Key="Tags_New">Novi tag</sys:String>
    <sys:String x:Key="Tags_Col_Tag">Tag</sys:String>
    <sys:String x:Key="Tags_Col_Documents">Broj dokumenata</sys:String>
    <sys:String x:Key="Tags_Empty">Još nema tagova. Kreirajte prvi klikom na „Novi tag“.</sys:String>

    <!-- Tag editor -->
    <sys:String x:Key="Tags_NewTitle">Novi tag</sys:String>
    <sys:String x:Key="Tags_EditTitle">Uredi tag</sys:String>
    <sys:String x:Key="Tags_Name">Naziv taga</sys:String>
    <sys:String x:Key="Tags_Color">Boja</sys:String>
    <sys:String x:Key="Tags_Preview">Pregled:</sys:String>
    <sys:String x:Key="Tags_Error_NameRequired">Naziv je obavezan.</sys:String>
    <sys:String x:Key="Tags_Error_NameTooLong">Naziv može imati najviše 128 znakova.</sys:String>
    <sys:String x:Key="Tags_Error_NameExists">Tag sa ovim nazivom već postoji.</sys:String>
    <sys:String x:Key="Tags_Error_Rejected">Server nije prihvatio tag.</sys:String>

    <!-- Tag messages ({0} = tag name, {1} = number of documents) -->
    <sys:String x:Key="Tags_Created">Tag „{0}“ je kreiran.</sys:String>
    <sys:String x:Key="Tags_Updated">Tag „{0}“ je sačuvan.</sys:String>
    <sys:String x:Key="Tags_Deleted">Tag „{0}“ je obrisan.</sys:String>
    <sys:String x:Key="Tags_DeleteTitle">Obrisati tag?</sys:String>
    <sys:String x:Key="Tags_DeleteConfirm">Da li ste sigurni da želite obrisati tag „{0}“? Ova radnja se ne može poništiti.</sys:String>
    <sys:String x:Key="Tags_DeleteConfirmUsed">Tag „{0}“ je dodijeljen dokumentima: {1}. Tag će biti uklonjen sa svih njih, a sami dokumenti ostaju sačuvani. Ova radnja se ne može poništiti.</sys:String>


</ResourceDictionary>